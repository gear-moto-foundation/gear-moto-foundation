---
import Base from '../layouts/Base.astro';
const products = [
{title:'Signature GEAR Tee',slug:'signature-tee',price:30,category:'Unisex',type:'T-Shirts',image:'gear-moto-foundation-unisex-signature-black-tshirt.jpg',description:'Everyday GEAR identity. All bikes. All riders.'},
{title:'GEAR Essential Hoodie',slug:'essential-hoodie',price:75,category:'Unisex',type:'Hoodies',image:'gear-moto-foundation-unisex-black-hoodie.jpg',description:'Warm everyday layers with mission-first styling.'},
{title:'GEAR Logo Cap',slug:'logo-cap',price:30,category:'Accessories',type:'Accessories',image:'gear-moto-foundation-embroidered-logo-cap.jpg',description:'Low-key everyday motorcycle community branding.'},
{title:'Rider Decal Pack',slug:'decal-pack',price:12,category:'Accessories',type:'Accessories',image:'gear-moto-foundation-motorcycle-sticker-pack.jpg',description:'A little GEAR for your toolbox, garage or travel gear.'},
{title:"Women's Fitted Tee",slug:'womens-fitted-tee',price:30,category:'Women',type:'T-Shirts',image:'gear-moto-foundation-womens-fitted-logo-tshirt.jpg',description:'A more tailored fit with a simple GEAR graphic.'},
{title:"Women's Racerback Tank",slug:'womens-racerback-tank',price:25,category:'Women',type:'Tanks',image:'gear-moto-foundation-womens-racerback-tank.jpg',description:'Lightweight, warm-weather casual wear.'},
{title:"Women's Cropped Hoodie",slug:'womens-cropped-hoodie',price:75,category:'Women',type:'Hoodies',image:'gear-moto-foundation-womens-cropped-hoodie.jpg',description:'A modern cropped layer with the same rider-first message.'},
{title:"Women's V-Neck Tee",slug:'womens-vneck-tee',price:30,category:'Women',type:'T-Shirts',image:'gear-moto-foundation-womens-vneck-logo-tshirt.jpg',description:'An easygoing neckline with the signature mark.'}
];
---
<Base title="GEAR Shop — Merchandise Concepts" description="Explore GEAR Moto Foundation merchandise concepts including rider T-shirts, hoodies, women's apparel, caps and stickers. Store launch details coming soon.">
<section class="shop-hero"><div class="wrap shop-hero-inner"><div><span class="section-label">GEAR MOTO FOUNDATION / THE SHOP</span><h1>RIDE WITH<br/><span>PURPOSE.</span></h1><p>Made for the community. Inspired by the ride. Explore our first lineup of GEAR apparel and accessories.</p><div class="actions"><a href="#shop-collection" class="btn btn-red">Explore the Collection ↘</a><a href="mailto:shop@gearmotofoundation.org?subject=GEAR%20Merchandise%20Inquiry" class="btn hero-outline">Ask About Merchandise ↗</a></div></div><div class="shop-hero-art"><img src="/images/Gear_Logo_White.png" alt="GEAR Moto Foundation logo"/></div></div></section>
<div class="shop-status"><div class="wrap"><strong>COMING SOON</strong> — These are design concepts, not products currently available to order. Displayed prices are proposed and subject to change. Sizing, vendors and checkout have not been finalized.</div></div>
<section class="shop-catalog section" id="shop-collection"><div class="wrap"><div class="section-heading"><div><span class="section-label">THE FIRST COLLECTION</span><h2>REPRESENT<br/><span>THE RIDE.</span></h2></div><p>Black. White. Ignition red. An identity rooted in our four pillars and a community open to every rider.</p></div>
<div class="shop-toolbar"><div class="shop-filters" role="group" aria-label="Filter merchandise"><button type="button" class="shop-filter active" data-category="All" aria-pressed="true">All Products</button><button type="button" class="shop-filter" data-category="Unisex" aria-pressed="false">Unisex</button><button type="button" class="shop-filter" data-category="Women" aria-pressed="false">Women's</button><button type="button" class="shop-filter" data-category="Accessories" aria-pressed="false">Accessories</button></div><span id="shop-count">{products.length} concepts</span></div>
<div class="shop-product-grid">{products.map((item)=><article class="shop-product" data-product-category={item.category}><div class="shop-product-media"><img src={'/images/shop/'+item.image+'?v=realistic-20261012'} alt={item.title+' — merchandise concept mockup'} loading="lazy" decoding="async"/><span class="shop-concept-tag">CONCEPT</span></div><div class="shop-product-info"><span>{item.category} / {item.type}</span><h3>{item.title}</h3><strong class="shop-product-price">${item.price.toFixed(2)}</strong><p>{item.description}</p><a href={'mailto:shop@gearmotofoundation.org?subject='+encodeURIComponent('GEAR Shop: '+item.title)} class="shop-inquiry">Interested? Get in touch <span aria-hidden="true">↗</span></a></div></article>)}</div><p id="shop-empty" hidden>No designs match that category yet.</p></div></section>
<div class="wrap" style="padding-top:24px;padding-bottom:24px"><p class="shop-email-note">Questions about the collection, product sizing, wholesale or future orders? Email <a href="mailto:shop@gearmotofoundation.org">shop@gearmotofoundation.org</a>. The store is not taking orders yet.</p></div><section class="shop-purpose"><div class="wrap shop-purpose-grid"><div><span class="section-label">MORE THAN MERCH</span><h2>EVERY PIECE<br/>HAS A PURPOSE.</h2></div><div><p>GEAR is building a rider-led charitable mission centered on protective gear, education, assistance and recovery. We want this collection to help people recognize—and talk about—that mission.</p><p>Our merchandise program is in development. Displayed prices are preliminary. We will publish final product specifications, prices and any claims about proceeds supporting programs only after they're confirmed.</p><a class="text-arrow" href="/about/">Learn about our mission ↗</a></div></div></section>
<section class="closing-cta shop-cta"><div class="wrap"><span class="section-label">BE FIRST IN LINE</span><h2>THE ROAD<br/><em>STARTS HERE.</em></h2><p>Interested in merch, a wholesale partnership or helping bring the first collection to life?</p><a href="mailto:shop@gearmotofoundation.org?subject=GEAR%20Shop%20Partnership" class="btn btn-white">Contact GEAR ↗</a></div></section>
<script is:inline>
(()=>{const buttons=[...document.querySelectorAll('.shop-filter')];const items=[...document.querySelectorAll('.shop-product')];const count=document.getElementById('shop-count');const empty=document.getElementById('shop-empty');buttons.forEach(btn=>btn.addEventListener('click',()=>{const filter=btn.dataset.category;let shown=0;buttons.forEach(b=>{const on=b===btn;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on));});items.forEach(item=>{const show=filter==='All'||item.dataset.productCategory===filter;item.hidden=!show;if(show)shown++;});count.textContent=shown+' concepts';empty.hidden=shown>0;}));})();
</script>
</Base>