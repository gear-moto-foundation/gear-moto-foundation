---
import Base from '../layouts/Base.astro';
const pillars=[
{letter:'G',name:'Gear',id:'gear',logo:'/images/Gear_G.png',tagline:'Protection starts before the ride.',focus:'Protective gear access',image:'/images/motorcycle-protective-gear-helmet-jacket-boots-utah.jpg',alt:'Rider wearing protective motorcycle equipment beside a bike',description:'Our proposed Gear program will help qualifying riders access essential protective equipment, including compliant helmets, armored riding apparel, gloves, and boots. Planned delivery methods include partner discounts, vouchers, donated equipment, and direct-to-vendor awards, subject to funding and approved eligibility policies.',points:['Compliant helmets and protective apparel','Partner discounts and potential vouchers','Equipment access based on approved need']},
{letter:'E',name:'Education',id:'education',logo:'/images/Gear_E.png',tagline:'Knowledge makes every mile count.',focus:'Rider education',image:'/images/motorcycle-rider-safety-training-course.jpg',alt:'Motorcycle instructor explaining skills to helmeted riders in a training course',description:'Education will focus on access to new-rider training, advanced and returning-rider courses, endorsement-related education, and relevant road-safety or first-aid learning. Proposed awards will use objective, need-based criteria and approved training providers.',points:['New, returning and experienced rider learning','Endorsement-related education','Approved training providers and need-based criteria']},
{letter:'A',name:'Assistance',id:'assistance',logo:'/images/Gear_A.png',tagline:'A connection when you need one.',focus:'Rider & family assistance',image:'/images/gear-moto-foundation-rider-recovery-support.jpg',alt:'Illustrative scene of a rider reviewing support resources with a companion',description:'Assistance focuses on practical help before or after challenges arise: helping riders find trustworthy resources, navigate available support services, and connect with relevant community partners. Specific Assistance services and eligibility requirements are still being developed.',points:['Finding relevant community resources','Navigating support and available services','Connections with potential service partners']},
{letter:'R',name:'Recovery',id:'recovery',logo:'/images/Gear_R.png',tagline:'The road forward looks different for everyone.',focus:'Recovery & reconnection',image:'/images/motorcycle-crash-recovery-medical-bills-support.jpg',alt:'Rider and supportive companion reviewing medical paperwork',description:'Recovery focuses on the consequences of motorcycle crashes. The proposed program aims to provide need-based accident-related financial relief for qualifying riders and families, potentially including uncovered medical and rehabilitation costs, deductibles or other out-of-pocket expenses, and essential hardship needs while a rider recovers. Awards will depend on approved policies, documented need, and available funding. Recovery also means rebuilding stability and well-being; no rider is expected or pressured to ride again.',points:['Potential relief for eligible crash-related expenses','Recovery resources for riders and families','Support for rebuilding stability, not pressure to ride again']}
];
---
<Base title="Our Programs" description="Explore GEAR Moto Foundation's developing Gear, Education, Assistance and Recovery programs for motorcycle riders.">
<section class="gear-program-hero"><div class="wrap gear-program-hero-grid"><div><span class="gear-program-overline">THE FOUR PILLARS OF GEAR</span><h1>THE RIDE<br/>MATTERS.<br/><em>THE RIDER<br/>MATTERS MORE.</em></h1><p>Four connected commitments supporting riders before a crash and through the challenges that may follow. All bikes. All riders.</p><a class="gear-program-scroll" href="#explore-programs">Explore the four pillars <span aria-hidden="true">↓</span></a></div><div class="gear-program-hero-side" aria-label="GEAR four pillar names"><span>G <strong>GEAR</strong></span><span>E <strong>EDUCATION</strong></span><span>A <strong>ASSISTANCE</strong></span><span>R <strong>RECOVERY</strong></span><small>RIDERS HELPING RIDERS</small></div></div></section>
<section class="gear-program-index" id="explore-programs"><div class="wrap"><div class="gear-program-section-top"><div><span class="gear-program-overline">FIND YOUR WAY</span><h2>ONE MISSION. <span>FOUR PILLARS.</span></h2></div><p>Choose a pillar to learn what we hope to offer as programs develop.</p></div><nav class="gear-program-index-grid" aria-label="Explore GEAR pillars">{pillars.map((p,i)=><a class="gear-program-index-card" href={'#'+p.id}><div class="gear-program-index-top"><img src={p.logo} alt="" loading="lazy"/><span>0{i+1} / 04</span></div><strong>{p.name}</strong><p>{p.tagline}</p><span class="gear-program-index-go">Explore {p.name} <span aria-hidden="true">↗</span></span></a>)}</nav></div></section>
<section class="gear-program-detail-area" aria-label="Program details">{pillars.map((p,i)=><article class={'gear-program-detail gear-program-detail-'+p.id} id={p.id}><div class="wrap gear-program-detail-grid"><div class="gear-program-detail-copy"><div class="gear-program-detail-meta"><img src={p.logo} alt="" loading="lazy"/><span>PROGRAM 0{i+1} / 04</span></div><span class="gear-program-overline">GEAR MOTO FOUNDATION / {p.name.toUpperCase()}</span><h2>{p.focus}</h2><p class="gear-program-tagline">{p.tagline}</p><p class="gear-program-main-text">{p.description}</p><details class="gear-program-details"><summary>What this pillar aims to support <span aria-hidden="true">+</span></summary><ul>{p.points.map(pt=><li>{pt}</li>)}</ul></details><div class="gear-program-detail-actions">{p.id==='assistance' ? <a href="mailto:assistance@gearmotofoundation.org?subject=GEAR%20Assistance%20Inquiry">Contact Assistance ↗</a> : <a href="/get-help/">Learn about support availability ↗</a>}<a href="#explore-programs">Back to all pillars ↑</a></div></div><figure class="gear-program-detail-photo"><img src={p.image} alt={p.alt} loading="lazy" decoding="async"/><figcaption>Illustrative imagery — GEAR programs are in development.</figcaption></figure></div></article>)}</section>
<section class="gear-program-final"><div class="wrap gear-program-final-grid"><div><span class="gear-program-overline">WHERE WE ARE TODAY</span><h2>BUILDING THE<br/><span>FOUNDATION.</span></h2><p>Every great mission starts with a commitment to doing the work responsibly. We're developing program guidelines and partnerships before announcing assistance or applications.</p></div><div class="gear-program-final-panel"><strong>Program launch status</strong><p>All four pillars are in development. Applications, award amounts, selection requirements, and opening dates have not yet been announced.</p><div class="actions"><a class="btn btn-red" href="/contact/">Ask About GEAR</a><a class="btn btn-outline-dark" href="/get-help/">Get Help Information</a></div></div></div></section>
</Base>
