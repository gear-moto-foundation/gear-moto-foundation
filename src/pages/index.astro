---
import Base from '../layouts/Base.astro';
const pillars=[
{letter:'G',name:'Gear',image:'/images/Gear_G.png',description:'Helping qualifying riders access helmets, armored apparel, gloves, boots, and other essential protective equipment.'},
{letter:'E',name:'Education',image:'/images/Gear_E.png',description:'Reducing barriers to basic and advanced rider courses, endorsements, and road-safety education.'},
{letter:'A',name:'Assistance',image:'/images/Gear_A.png',description:'Helping riders navigate practical challenges, connect with community resources, and find appropriate support services.'},
{letter:'R',name:'Recovery',image:'/images/Gear_R.png',description:'Developing accident-related financial relief, uncovered medical and rehabilitation expense support, and resources for riders and families recovering after a crash.'}
];
---
<Base title="Home" description="GEAR Moto Foundation: Gear, Education, Assistance, Recovery. Riders helping riders before the crash, on the road, and through recovery.">
<section class="hero"><div class="wrap hero-in"><img class="hero-logo" src="/images/Gear_Logo_White.png" alt="GEAR Moto Foundation"/><div class="eyebrow">Protect the Ride. Support the Rider.</div><h1><span>Gear Up.</span><span>Ride Smart.</span><span class="accent">Keep Moving.</span></h1><p>Riders helping riders—before the crash, on the road, and when life goes sideways. We're building practical programs for protective gear, rider education, accident-related assistance, and recovery.</p><div class="actions"><a class="btn btn-red" href="/programs/">Discover GEAR</a><a class="btn" href="/contact/">Get Involved</a></div></div></section>
<section class="section"><div class="wrap"><div class="eyebrow" style="color:#D71920">What GEAR stands for</div><h2>Four Letters. One Mission.</h2><p class="lede">Our name is our commitment: <strong>Gear. Education. Assistance. Recovery.</strong> Every program we're developing is rooted in one of these four pillars.</p><div class="cards gear-grid">{pillars.map(p=><article class="card pillar-card"><img class="pillar-image" src={p.image} alt={`${p.letter} — ${p.name} GEAR pillar`} loading="lazy"/><h3>{p.name}</h3><p>{p.description}</p></article>)}</div><div class="actions"><a class="btn btn-red" href="/programs/">Explore the Four Pillars</a></div></div></section>
<section class="section" style="background:#fafbfc"><div class="wrap"><div class="eyebrow" style="color:#D71920">Our purpose</div><h2>All Bikes. All Riders.</h2><p class="lede">GEAR is being built as an independent, rider-led charitable initiative—not a club or a brand-specific group. The goal is to make safer riding more accessible and help qualifying riders and families find support in difficult moments.</p></div></section>
<section class="section dark"><div class="wrap"><img class="dark-logo" src="/images/Gear_Logo_White.png" alt="GEAR Moto Foundation"/><h2>People. Motorcycles.<br/>Stronger Together.</h2><p class="lede">We are developing partnerships, community events, and sustainable programs built around the full GEAR mission. Help build what's next.</p><div class="actions"><a class="btn btn-red" href="/contact/">Explore Partnerships</a><a class="btn" href="/get-help/">Program Status</a></div></div></section>
<div class="notice">GEAR programs are in development. Assistance applications and online donations are not currently open.</div>
</Base>
