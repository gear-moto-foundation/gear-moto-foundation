---
import Base from '../layouts/Base.astro';
const calendarId = '8e65ba6619a66d3ee45cdae72b8a4ee23cb3648ba4d4b69464fcc0922aba3298@group.calendar.google.com';
const calendarEmbedUrl = 'https://calendar.google.com/calendar/embed?src=' + encodeURIComponent(calendarId) + '&ctz=America%2FDenver&mode=MONTH&showTitle=0&showPrint=0&showTabs=1&showCalendars=0&showTz=0&bgcolor=%23FFFFFF';
const calendarPublicUrl = 'https://calendar.google.com/calendar/u/0?cid=' + encodeURIComponent(calendarId);

---
<Base title="Community Events" description="GEAR Moto Foundation's proposed rider community and fundraising events.">
<section class="inner-hero"><div class="wrap"><div class="eyebrow">Community &amp; Connection</div><h1>More Riders.<br/><span class="accent">Stronger Community.</span></h1><p class="lede" style="color:#e5e8eb">Events are how we intend to bring riders, local businesses, and community partners together to support the GEAR mission.</p></div></section>

<section class="section"><div class="wrap"><div class="eyebrow accent">Planned event concepts</div><h2>Get in GEAR. Show Up.</h2><figure class="editorial-photo"><img src="/images/motorcycle-community-coffee-shop-meetup.jpg" alt="Motorcyclists meeting for coffee beside parked motorcycles at an outdoor café." loading="lazy" decoding="async" width="1672" height="941"/><figcaption>Our planned community events bring riders and local businesses together. Illustrative image.</figcaption></figure><figure class="editorial-photo"><img src="/images/gear-moto-foundation-motorcycle-community-coffee-meetup.jpg" alt="Concept image of motorcyclists meeting for coffee near a mountain café." loading="lazy" decoding="async" width="1672" height="941"/><figcaption>Planned community gatherings — illustrative image, not an announced event.</figcaption></figure><div class="cards">
<article class="card"><h3>Bikes &amp; Burritos</h3><p>Rotating Tuesday gatherings with local taco and burrito restaurants. Participating venues may support the foundation through clearly disclosed charitable sales promotions.</p></article>
<article class="card"><h3>Bikes &amp; Brews</h3><p>Community meetups at coffee shops and roasters. “Brews” refers to coffee and nonalcoholic beverages in official GEAR programming.</p></article>
<article class="card"><h3>GEAR Nights</h3><p>Motorcycle shop, dealership, and community bike nights featuring rider connections, safety resources, and mission-aligned sponsors.</p></article>
<article class="card"><h3>Kickstands Up</h3><p>Noncompetitive community rides with rider briefings, safety planning, route leaders, and appropriate event safeguards.</p></article>
<article class="card"><h3>GEAR Rally</h3><p>A proposed annual signature gathering celebrating riders and raising support for the foundation's four pillars.</p></article>
</div><div class="program-callout"><strong>Event status:</strong> These are planned formats, not announced events. Dates, venues, sponsors, and registration will be published only after confirmation.</div><div class="actions"><a class="btn btn-red" href="/contact/">Discuss Hosting an Event</a></div></div></section>
<section class="section gear-events-calendar" id="calendar"><div class="wrap"><div class="eyebrow accent">Community Calendar</div><h2>Upcoming GEAR Events</h2><p class="gear-calendar-intro">Explore scheduled gatherings, education sessions, group rides and community activities. Select an event for its latest details. Only confirmed events added to the official GEAR calendar are shown below.</p><div class="gear-calendar-shell"><div class="gear-calendar-topline"><strong>GEAR MOTO FOUNDATION / COMMUNITY EVENTS</strong><a href={calendarPublicUrl} target="_blank" rel="noopener noreferrer">Open full calendar ↗</a></div><iframe class="gear-calendar-embed" title="GEAR Moto Foundation public community events calendar" src={calendarEmbedUrl} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><p class="gear-calendar-note">Calendar displayed in Mountain Time. Events and dates are maintained directly in the official GEAR Google Calendar. If the calendar does not load, <a href={calendarPublicUrl} target="_blank" rel="noopener noreferrer">view it in Google Calendar</a>.</p></div></section>
</Base>