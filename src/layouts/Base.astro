---
import '../styles/global.css';
const {title='GEAR Moto Foundation',description='Gear. Education. Assistance. Recovery. Riders helping riders.'}=Astro.props;
const path=Astro.url.pathname;
const links=[['/programs/','Our Mission'],['/events/','Community'],['/volunteer/','Get Involved'],['/about/','Our Foundation']];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#111820"/><link rel="canonical" href={new URL(path,Astro.site || 'https://gearmotofoundation.org').toString()}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><title>{title} | GEAR Moto Foundation</title></head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="announcement"><div class="wrap">RIDER-LED. MISSION-DRIVEN. <span>Our foundation programs are being developed.</span> <a href="/about/">Learn our story <span aria-hidden="true">↗</span></a></div></div>
<header class="header"><div class="nav wrap"><a class="brand-link" href="/" aria-label="GEAR Moto Foundation home"><img src="/images/Gear_Logo_Main.png" alt="GEAR Moto Foundation" width="960" height="300" decoding="async"/></a>
<details class="mobile-menu"><summary aria-label="Toggle navigation"><span class="menu-icon">☰</span> Menu</summary><nav class="mobile-menu-panel" aria-label="Mobile navigation">{links.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<a href="/get-help/">Get Help</a><a href="/partners/">Partnerships</a><a href="/governance/">Governance</a><a href="/contact/">Contact</a><a class="btn btn-red" href="/donate/">Support the Mission ↗</a></nav></details>
<nav class="navlinks" aria-label="Main navigation">{links.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav><a class="header-help" href="/get-help/">Get Help</a><a class="btn btn-red nav-cta" href="/donate/">Support the Mission <span aria-hidden="true">↗</span></a></div></header>
<main id="main-content"><slot/></main>
<footer class="site-footer"><div class="wrap footer-top"><div class="footer-brand"><img src="/images/Gear_Logo_Main.png" alt="GEAR Moto Foundation" width="960" height="300" loading="lazy" decoding="async"/><p>Protect the ride. Support the rider.</p><span>Gear · Education · Assistance · Recovery</span></div><div class="footer-col"><h2>Explore</h2><a href="/about/">Our Story</a><a href="/leadership/">Board &amp; Leadership</a><a href="/programs/">Programs</a><a href="/events/">Community Events</a><a href="/impact/">Our Impact</a><a href="/governance/">Governance &amp; Transparency</a></div><div class="footer-col"><h2>Take Action</h2><a href="/get-help/">Get Help</a><a href="/volunteer/">Volunteer</a><a href="/partners/">Become a Partner</a><a href="/donate/">Support the Mission</a><a href="/shop/">Shop GEAR</a></div><div class="footer-col footer-contact"><h2>Contact GEAR</h2><p>Questions or want to connect? Start with the right team.</p><a href="mailto:info@gearmotofoundation.org?subject=GEAR%20Foundation%20Inquiry">General inquiries<br/><span>info@gearmotofoundation.org</span></a><a href="mailto:recovery@gearmotofoundation.org?subject=GEAR%20Rider%20Support%20Inquiry">Rider support<br/><span>recovery@gearmotofoundation.org</span></a><a href="mailto:volunteer@gearmotofoundation.org?subject=GEAR%20Volunteer%20Interest">Volunteer inquiries<br/><span>volunteer@gearmotofoundation.org</span></a><a class="footer-contact-all" href="/contact/">View all contact options ↗</a><p>All bikes. All riders.</p></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} GEAR Moto Foundation. All rights reserved.</span><span>Programs and donation options in development. No applications are open.</span><span><a href="/privacy/">Privacy</a> · <a href="/accessibility/">Accessibility</a> · <a href="/governance/">Governance</a></span></div></footer>
</body></html>